+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderToStaticMarkup } from 'react-dom/server';
+
+import Date from './date';
+
+test('renders the source date and formatted text in a time element', () => {
+  const markup = renderToStaticMarkup(<Date dateString="2020-01-02" />);
+
+  assert.match(
+    markup,
+    /^<time date[Tt]ime="2020-01-02">January 2, 2020<\/time>$/,
+  );
+});
