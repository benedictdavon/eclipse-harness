+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { generateYAxis } from './utils';
+
+test('returns a zero axis for empty revenue', () => {
+  assert.deepEqual(generateYAxis([]), {
+    yAxisLabels: ['$0K'],
+    topLabel: 0,
+  });
+});
+
+test('preserves non-empty rounding and descending labels', () => {
+  assert.deepEqual(generateYAxis([{ month: 'Jan', revenue: 1500 }]), {
+    yAxisLabels: ['$2K', '$1K', '$0K'],
+    topLabel: 2000,
+  });
+
+  assert.deepEqual(
+    generateYAxis([
+      { month: 'Jan', revenue: 1000 },
+      { month: 'Feb', revenue: 3000 },
+    ]),
+    {
+      yAxisLabels: ['$3K', '$2K', '$1K', '$0K'],
+      topLabel: 3000,
+    },
+  );
+});
