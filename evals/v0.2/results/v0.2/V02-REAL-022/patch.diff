+++ b/dashboard/starter-example/app/ui/invoices/status.test.tsx
@@ -0,0 +1,39 @@
+import { CheckIcon, ClockIcon } from '@heroicons/react/24/outline';
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderToStaticMarkup } from 'react-dom/server';
+
+import InvoiceStatus from './status';
+
+const baseClass = 'inline-flex items-center rounded-full px-2 py-1 text-xs';
+
+test('preserves the exact pending rendering configuration', () => {
+  const actual = renderToStaticMarkup(<InvoiceStatus status="pending" />);
+  const expected = renderToStaticMarkup(
+    <span className={`${baseClass} bg-gray-100 text-gray-500`}>
+      Pending
+      <ClockIcon className="ml-1 w-4 text-gray-500" />
+    </span>,
+  );
+
+  assert.equal(actual, expected);
+});
+
+test('preserves the exact paid rendering configuration', () => {
+  const actual = renderToStaticMarkup(<InvoiceStatus status="paid" />);
+  const expected = renderToStaticMarkup(
+    <span className={`${baseClass} bg-green-500 text-white`}>
+      Paid
+      <CheckIcon className="ml-1 w-4 text-white" />
+    </span>,
+  );
+
+  assert.equal(actual, expected);
+});
+
+test('preserves an empty base pill for unsupported strings', () => {
+  assert.equal(
+    renderToStaticMarkup(<InvoiceStatus status="unsupported" />),
+    `<span class="${baseClass}"></span>`,
+  );
+});
