diff --git a/dashboard/starter-example/app/ui/invoices/status.test.tsx b/dashboard/starter-example/app/ui/invoices/status.test.tsx
new file mode 100644
index 0000000..c072b4b
--- /dev/null
+++ b/dashboard/starter-example/app/ui/invoices/status.test.tsx
@@ -0,0 +1,26 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { renderToStaticMarkup } from 'react-dom/server';
+
+import InvoiceStatus from './status';
+
+test('renders an accessible amber overdue status', () => {
+  const markup = renderToStaticMarkup(<InvoiceStatus status="overdue" />);
+
+  assert.match(markup, />Overdue</);
+  assert.match(markup, /bg-amber-100 text-amber-700/);
+  assert.match(markup, /aria-hidden="true"/);
+  assert.match(markup, /text-amber-700/);
+});
+
+test('preserves pending and paid status markup', () => {
+  const pending = renderToStaticMarkup(<InvoiceStatus status="pending" />);
+  const paid = renderToStaticMarkup(<InvoiceStatus status="paid" />);
+
+  assert.match(pending, />Pending</);
+  assert.match(pending, /bg-gray-100 text-gray-500/);
+  assert.match(pending, /text-gray-500/);
+  assert.match(paid, />Paid</);
+  assert.match(paid, /bg-green-500 text-white/);
+  assert.match(paid, /text-white/);
+});
