@@ -0,0 +1,21 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+import { generatePagination } from './utils';
+
+test('returns no pagination entries for zero pages', () => {
+  assert.deepEqual(generatePagination(1, 0), []);
+  assert.deepEqual(generatePagination(10, 0), []);
+});
+
+test('clamps the current page into the positive page range', () => {
+  assert.deepEqual(generatePagination(0, 10), generatePagination(1, 10));
+  assert.deepEqual(generatePagination(11, 10), generatePagination(10, 10));
+});
+
+test('preserves representative valid pagination shapes', () => {
+  assert.deepEqual(generatePagination(2, 5), [1, 2, 3, 4, 5]);
+  assert.deepEqual(generatePagination(2, 10), [1, 2, 3, '...', 9, 10]);
+  assert.deepEqual(generatePagination(5, 10), [1, '...', 4, 5, 6, '...', 10]);
+  assert.deepEqual(generatePagination(9, 10), [1, 2, '...', 8, 9, 10]);
+});
