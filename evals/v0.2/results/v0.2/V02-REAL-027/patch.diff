index 0000000..2330f5e
--- /dev/null
+++ b/packages/should-skip-package/src/index.test.ts
@@ -0,0 +1,40 @@
+import type { Package } from "@changesets/types";
+import { expect, test } from "vitest";
+import { shouldSkipPackage, shouldSkipPackageReason } from "./index.ts";
+
+const pkg = (name: string, version: string, isPrivate = false): Package => ({
+  dir: `/packages/${name}`,
+  packageJson: { name, version, private: isPrivate },
+});
+
+const cases = [
+  {
+    name: "ignored takes precedence over private and missing version",
+    package: pkg("ignored", "", true),
+    options: { ignore: ["ignored"], allowPrivatePackages: false },
+    reason: "ignored",
+  },
+  {
+    name: "disallowed private takes precedence over missing version",
+    package: pkg("private", "", true),
+    options: { ignore: [], allowPrivatePackages: false },
+    reason: "private",
+  },
+  {
+    name: "allowed private package can still be missing a version",
+    package: pkg("missing", "", true),
+    options: { ignore: [], allowPrivatePackages: true },
+    reason: "missing-version",
+  },
+  {
+    name: "eligible package is not skipped",
+    package: pkg("published", "1.0.0"),
+    options: { ignore: [], allowPrivatePackages: false },
+    reason: null,
+  },
+] as const;
+
+test.each(cases)("$name", ({ package: packageValue, options, reason }) => {
+  expect(shouldSkipPackageReason(packageValue, options)).toBe(reason);
+  expect(shouldSkipPackage(packageValue, options)).toBe(reason !== null);
+});
