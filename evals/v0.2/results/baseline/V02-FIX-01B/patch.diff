+++ b/src/pricing.py
@@ -3,3 +3,10 @@ def calculate_total(amounts: list[int]) -> int:
     if any(amount < 0 for amount in amounts):
         raise ValueError("amounts must be non-negative")
     return sum(amounts)
+
+
+def format_total(cents: int) -> str:
+    """Format an integer number of cents as a USD amount."""
+    sign = "-" if cents < 0 else ""
+    dollars, remaining_cents = divmod(abs(cents), 100)
+    return f"{sign}${dollars}.{remaining_cents:02d}"
