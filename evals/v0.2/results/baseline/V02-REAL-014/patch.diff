+test('minimumDelayMs normalizes defaults and negative values', t => {
+	t.is(normalizeRetryOptions({}).minimumDelayMs, 0);
+	t.is(normalizeRetryOptions({minimumDelayMs: undefined}).minimumDelayMs, 0);
+	t.is(normalizeRetryOptions(1).minimumDelayMs, 0);
+	t.is(normalizeRetryOptions({minimumDelayMs: -100}).minimumDelayMs, 0);
+	t.is(normalizeRetryOptions({minimumDelayMs: 100}).minimumDelayMs, 100);
+});
+
+test('minimumDelayMs floors the built-in retry delay before jitter', async t => {
+	let requestCount = 0;
+	const jitterCalls: number[] = [];
+	const server = await createHttpTestServer(t);
+	server.get('/', (_request, response) => {
+		requestCount++;
+		response.sendStatus(requestCount === 1 ? 500 : 200);
+	});
+
+	await ky(server.url, {
+		retry: {
+			limit: 1,
+			minimumDelayMs: 1000,
+			jitter(delay) {
+				jitterCalls.push(delay);
+				return 0;
+			},
+		},
+	});
+
+	t.deepEqual(jitterCalls, [1000]);
+});
+
