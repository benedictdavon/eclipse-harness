{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benedictdavon/eclipse-harness/schemas/config.schema.json",
  "title": "Eclipse Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "profile", "adapter", "routing", "concurrency", "budgets", "git", "validation", "security"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "policy": {"type": "string", "minLength": 1},
    "profile": {"enum": ["strict", "standard", "fast"]},
    "adapter": {"enum": ["auto", "codex", "copilot", "manual"]},
    "routing": {"type": "object", "additionalProperties": false, "required": ["unverified_route_behavior", "allow_worker_effort_escalation"], "properties": {"unverified_route_behavior": {"enum": ["fail", "policy-only", "manual"]}, "allow_worker_effort_escalation": {"type": "boolean"}}},
    "concurrency": {"type": "object", "additionalProperties": false, "required": ["max_parallel_writers", "max_parallel_readers"], "properties": {"max_parallel_writers": {"type": "integer", "minimum": 1, "maximum": 16}, "max_parallel_readers": {"type": "integer", "minimum": 1, "maximum": 64}}},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["max_attempts", "max_review_rounds"], "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 10}, "max_review_rounds": {"type": "integer", "minimum": 0, "maximum": 10}}},
    "git": {"type": "object", "additionalProperties": false, "required": ["parallel_write_isolation", "require_clean_base", "branch_prefix"], "properties": {"parallel_write_isolation": {"enum": ["worktree", "branch", "none"]}, "require_clean_base": {"type": "boolean"}, "branch_prefix": {"type": "string", "minLength": 1}}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["require_all_criteria_evidence", "reject_stale_results"], "properties": {"require_all_criteria_evidence": {"type": "boolean"}, "reject_stale_results": {"type": "boolean"}}},
    "security": {"type": "object", "additionalProperties": false, "required": ["network_default", "repository_content_trust", "reject_probable_secrets", "forbid_run_state_writes"], "properties": {"network_default": {"enum": ["deny", "allow-authorized"]}, "repository_content_trust": {"enum": ["untrusted", "trusted"]}, "reject_probable_secrets": {"type": "boolean"}, "forbid_run_state_writes": {"type": "boolean"}}}
  }
}
