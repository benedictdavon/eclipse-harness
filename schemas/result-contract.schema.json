{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benedictdavon/eclipse-harness/schemas/result-contract.schema.json",
  "title": "Eclipse Result Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "plan_revision", "plan_digest", "task_id", "task_contract_digest", "attempt", "status", "worker_identity", "files_changed", "implementation_summary", "decisions", "commands", "criteria_evidence", "unresolved_issues", "blockers", "deviations", "observed_risks", "requested_escalation", "git", "usage", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"$ref": "#/$defs/id"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "minLength": 1},
    "task_id": {"$ref": "#/$defs/id"},
    "task_contract_digest": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "status": {"enum": ["complete", "blocked", "failed", "escalated"]},
    "worker_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "requested_model", "configured_model", "effective_model", "verification"],
      "properties": {"role": {"type": "string", "minLength": 1}, "requested_model": {"type": ["string", "null"]}, "configured_model": {"type": ["string", "null"]}, "effective_model": {"type": ["string", "null"]}, "verification": {"enum": ["host-observed", "unverified", "unavailable"]}}
    },
    "files_changed": {"$ref": "#/$defs/stringArray"},
    "implementation_summary": {"type": "string", "minLength": 1},
    "decisions": {"$ref": "#/$defs/stringArray"},
    "commands": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["command", "purpose", "exit_code", "outcome", "summary"],
        "properties": {"command": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "exit_code": {"type": ["integer", "null"]}, "outcome": {"enum": ["passed", "failed", "not-run"]}, "summary": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}},
        "allOf": [
          {"if": {"properties": {"outcome": {"const": "passed"}}}, "then": {"properties": {"exit_code": {"const": 0}}}},
          {"if": {"properties": {"outcome": {"const": "failed"}}}, "then": {"properties": {"exit_code": {"type": "integer", "not": {"const": 0}}}}},
          {"if": {"properties": {"outcome": {"const": "not-run"}}}, "then": {"properties": {"exit_code": {"type": "null"}}}}
        ]
      }
    },
    "criteria_evidence": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["criterion_id", "status", "evidence"],
        "properties": {"criterion_id": {"$ref": "#/$defs/id"}, "status": {"enum": ["satisfied", "unsatisfied", "not-tested"]}, "evidence": {"type": "string", "minLength": 1}}
      }
    },
    "unresolved_issues": {"$ref": "#/$defs/stringArray"},
    "blockers": {"$ref": "#/$defs/stringArray"},
    "deviations": {"$ref": "#/$defs/stringArray"},
    "observed_risks": {"$ref": "#/$defs/stringArray"},
    "requested_escalation": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["code", "reason", "route_to"], "properties": {"code": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "route_to": {"type": "string", "minLength": 1}}}
      ]
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["base_revision", "changed_files_digest"],
      "properties": {
        "base_revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40,64}$"},
        "changed_files_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality", "source"],
      "properties": {
        "quality": {"enum": ["measured", "estimated", "unavailable"]},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cost": {"type": ["number", "null"], "minimum": 0},
        "currency": {"type": ["string", "null"]},
        "source": {"type": "string", "minLength": 1}
      }
    },
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
