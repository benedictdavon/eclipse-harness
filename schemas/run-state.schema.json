{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/benedictdavon/eclipse-harness/schemas/run-state.schema.json",
  "title": "Eclipse Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "objective", "plan_revision", "plan_digest", "base_revision", "status", "tasks", "created_at", "updated_at", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "objective": {"type": "string", "minLength": 1},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_digest": {"type": "string", "minLength": 1},
    "base_revision": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "active", "blocked", "accepted", "failed", "aborted"]},
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["task_id", "contract_file", "contract_digest", "plan_revision", "dependencies", "state", "attempt", "review_rounds", "result_files", "review_files", "updated_at"],
        "properties": {
          "task_id": {"type": "string"}, "contract_file": {"type": "string"}, "contract_digest": {"type": "string"}, "plan_revision": {"type": "integer", "minimum": 1},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "state": {"enum": ["planned", "ready", "running", "evidence_pending", "review_pending", "changes_requested", "ready_for_correction", "accepted", "blocked", "escalated", "failed", "superseded"]},
          "attempt": {"type": "integer", "minimum": 0}, "review_rounds": {"type": "integer", "minimum": 0},
          "result_files": {"type": "array", "items": {"type": "string"}}, "review_files": {"type": "array", "items": {"type": "string"}}, "updated_at": {"type": "string"}
        }
      }
    },
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "metadata": {"type": "object"}
  }
}
